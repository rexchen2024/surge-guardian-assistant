# Copy this file to .env or run:
# scripts/surge-sentry setup

SURGE_CLI=/Applications/Surge.app/Contents/Applications/surge-cli
SURGE_LOG_DIR=${HOME}/Library/Logs/Surge

# Surge profile files to validate.
MAC_PROFILE="${HOME}/Library/Mobile Documents/iCloud~com~nssurge~inc/Documents/Mac.conf"
MOBILE_PROFILE="${HOME}/Library/Mobile Documents/iCloud~com~nssurge~inc/Documents/Mobile.conf"

# Target endpoint for node, DNS, and certificate checks.
CHECK_DOMAIN=edge.example.com
CHECK_IP=203.0.113.10

# Comma-separated Surge policy names that should exist and pass test-policy.
EXPECTED_POLICIES=US-Example-Trojan,US-Example-HY2

# Optional policy name used when the realtime sentry adds a temporary proxy rule.
PROXY_POLICY=Proxy

# Local state. Keep this outside the repo for normal use.
STATE_DIR=${HOME}/.hermes/state/surge-sentry

# Autonomy thresholds.
DIRECT_FAIL_WINDOW_SECONDS=900
TEMP_RULE_REVIEW_SECONDS=43200
EXTERNAL_RESOURCE_FAIL_THRESHOLD=2
DNS_FAIL_THRESHOLD=10
DIRECT_FAIL_THRESHOLD=3
POLICY_RECOVERED_ALERT_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=3600

# Optional local recurring maintenance windows.
# Leave empty by default. If you confirm that a router, ISP, or upstream service
# creates harmless repeated noise in a fixed window, configure it locally.
# Format: weekday HH:MM-HH:MM:kinds; weekday HH:MM-HH:MM:kinds
# Example: thu 05:00-05:10:dns,direct_domain_failure,proxy
MAINTENANCE_WINDOWS=
RECURRING_NOISE_BUCKET_MINUTES=10
RECURRING_NOISE_MIN_OCCURRENCES=3
RECURRING_NOISE_HISTORY_DAYS=35

AUTO_UPDATE=1
AUTO_UPDATE_INTERVAL_SECONDS=86400

# Optional low-overhead traffic risk analysis.
# This reads local Surge traffic SQLite files only. Keep private provider names,
# quotas, reset dates, and direct-preferred media domains in local .env.
TRAFFIC_ANALYSIS_ENABLED=0
TRAFFIC_STAT_DIR="${HOME}/Library/Application Support/com.nssurge.surge-mac/TrafficStatData"
TRAFFIC_POLICY_PATTERNS=
TRAFFIC_MONTHLY_CAP_GB=0
TRAFFIC_RESET_DAY=1
TRAFFIC_DAILY_WARN_RATIO=1.2
TRAFFIC_DAILY_CRITICAL_RATIO=2.0
TRAFFIC_DIRECT_HOST_PATTERNS=
TRAFFIC_DIRECT_LEAK_MIN_GB=1

# Optional real interaction/CDN health watcher. It uses Surge's incremental
# request event stream, not packet capture or repeated full request dumps.
CDN_WATCH_ENABLED=0
CDN_WATCH_CONFIG="${HOME}/.surge-sentry/config/cdn-watch.local.json"

# Optional routing ownership audit. It verifies that known service rule sources
# and precise local supplements still land in their intended policy group.
ROUTING_CONTRACTS_PATH="${HOME}/.surge-sentry/config/routing-contracts.local.json"
ROUTING_CONTRACT_AUDIT_INTERVAL_SECONDS=86400

# Optional one-policy rotating health probe. It runs one lightweight test per
# interval and only alerts after repeated failures for the same policy.
POLICY_PROBE_INTERVAL_SECONDS=900
POLICY_PROBE_FAILURE_THRESHOLD=3
