# Copy this file to .env or run:
# scripts/surge-hermes-guardian setup

SURGE_CLI=/Applications/Surge.app/Contents/Applications/surge-cli
SURGE_LOG_DIR=${HOME}/Library/Logs/Surge

# Surge profile files to validate.
MAC_PROFILE="${HOME}/Library/Mobile Documents/iCloud~com~nssurge~inc/Documents/Mac.conf"
MOBILE_PROFILE="${HOME}/Library/Mobile Documents/iCloud~com~nssurge~inc/Documents/Mobile.conf"

# Target endpoint for node, DNS, and certificate checks.
CHECK_DOMAIN=edge.example.com
CHECK_IP=203.0.113.10

# Comma-separated Surge policy names that should exist and pass test-policy.
EXPECTED_POLICIES=US-Example-Trojan,US-Example-HY2

# Optional policy name used when the realtime guardian adds a temporary proxy rule.
PROXY_POLICY=Proxy

# Local state. Keep this outside the repo for normal use.
STATE_DIR=${HOME}/.hermes/state/surge-hermes-guardian

# Autonomy thresholds.
DIRECT_FAIL_WINDOW_SECONDS=900
TEMP_RULE_REVIEW_SECONDS=43200
EXTERNAL_RESOURCE_FAIL_THRESHOLD=2
DNS_FAIL_THRESHOLD=5
DIRECT_FAIL_THRESHOLD=3
POLICY_RECOVERED_ALERT_THRESHOLD=3
